<%- include('partials/header', { title: 'Log in' }) %>
<div class="auth-card">
  <h1>Sentruo Admin</h1>
  <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Username
      <input type="text" name="username" autocomplete="username" required autofocus />
    </label>
    <label>Password
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <button type="submit">Log in</button>
  </form>
  <p class="muted" style="text-align:center;margin-top:12px;">Are you a customer? <a href="/portal/signup">Sign up</a> or <a href="/portal/login">log in</a> to your account.</p>
</div>
<%- include('partials/footer') %>
