<%- include('../partials/header', { title: 'Admin Users' }) %>
<div class="page-header">
  <h1>Admin Users</h1>
  <a class="btn" href="/admin-users/new">+ New user</a>
</div>
<table class="data-table">
  <thead>
    <tr><th>Username</th><th>Email</th><th>Status</th><th>Last login</th><th></th></tr>
  </thead>
  <tbody>
    <% users.forEach(function(u) { %>
    <tr>
      <td><a href="/admin-users/<%= u.id %>/edit"><%= u.username %></a> <% if (u.id === currentUserId) { %><span class="muted">(you)</span><% } %></td>
      <td><%= u.email %></td>
      <td><span class="badge <%= u.paused ? 'badge-suspended' : 'badge-active' %>"><%= u.paused ? 'paused' : 'active' %></span></td>
      <td><%= u.last_login_at || 'never' %></td>
      <td class="action-row">
        <a href="/admin-users/<%= u.id %>/edit">Edit</a>
        <form method="post" action="/admin-users/<%= u.id %>/pause" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="link-button"><%= u.paused ? 'Unpause' : 'Pause' %></button>
        </form>
        <% if (u.id !== currentUserId) { %>
        <form method="post" action="/admin-users/<%= u.id %>/delete" class="inline-form" data-confirm="Delete this admin user? This cannot be undone.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="link-button" style="color:var(--danger);">Delete</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<%- include('../partials/footer') %>
