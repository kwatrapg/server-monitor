<%- include('../partials/header', { title: 'Customers' }) %>
<div class="page-header">
  <h1>Customers</h1>
  <a class="btn" href="/customers/new">+ New customer</a>
</div>
<table class="data-table">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Company</th><th>Created</th><th></th></tr>
  </thead>
  <tbody>
    <% customers.forEach(function(c) { %>
    <tr>
      <td><a href="/customers/<%= c.id %>/edit"><%= c.name %></a></td>
      <td><%= c.email %></td>
      <td><%= c.company %></td>
      <td><%= c.created_at %></td>
      <td><a href="/customers/<%= c.id %>/edit">Edit</a></td>
    </tr>
    <% }); %>
    <% if (customers.length === 0) { %>
    <tr><td colspan="5" class="empty">No customers yet. <a href="/customers/new">Create one</a>.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
