<%- include('../partials/header', { title: 'Licenses' }) %>
<div class="page-header">
  <h1>Licenses</h1>
  <a class="btn" href="/licenses/new">+ New license</a>
</div>
<table class="data-table">
  <thead>
    <tr><th>Key</th><th>Customer</th><th>Plan</th><th>Amount</th><th>Status</th><th>Expires</th><th>Last verified</th><th></th></tr>
  </thead>
  <tbody>
    <% licenses.forEach(function(l) { %>
    <tr>
      <td><code><%= l.license_key %></code></td>
      <td><%= l.customer_name %> <span class="muted">&lt;<%= l.customer_email %>&gt;</span></td>
      <td><%= l.plan_name %></td>
      <td><%= l.amount_cents != null ? (l.amount_cents / 100).toFixed(2) + ' ' + l.currency : '—' %></td>
      <td><span class="badge badge-<%= l.status %>"><%= l.status %></span></td>
      <td><%= l.expires_at || '—' %></td>
      <td><%= l.last_verified_at || 'never' %></td>
      <td><a href="/licenses/<%= l.id %>/edit">Manage</a></td>
    </tr>
    <% }); %>
    <% if (licenses.length === 0) { %>
    <tr><td colspan="8" class="empty">No licenses yet. <a href="/licenses/new">Create one</a>.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
