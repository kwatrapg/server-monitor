<%- include('partials/header', { title: 'Sign up' }) %>
<div class="auth-card">
  <h1>Create your account</h1>
  <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
  <form method="post" action="/portal/signup">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label>Name
      <input type="text" name="name" required autofocus maxlength="200" />
    </label>
    <label>Email
      <input type="email" name="email" autocomplete="email" required maxlength="255" />
    </label>
    <label>Password
      <input type="password" name="password" autocomplete="new-password" minlength="12" required />
      <span class="hint">At least 12 characters.</span>
    </label>
    <button type="submit">Sign up</button>
  </form>
  <p class="muted" style="text-align:center;margin-top:12px;">Already have an account? <a href="/portal/login">Log in</a></p>
</div>
<%- include('partials/footer') %>
