<%- include('../partials/header', { title: 'Invoices' }) %>
<div class="page-header">
  <h1>Invoices</h1>
</div>
<table class="data-table">
  <thead>
    <tr><th>Number</th><th>Customer</th><th>Plan</th><th>Tax</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr>
  </thead>
  <tbody>
    <% invoices.forEach(function(i) { %>
    <tr>
      <td><code><%= i.invoice_number %></code></td>
      <td><%= i.customer_name %> <span class="muted">&lt;<%= i.customer_email %>&gt;</span></td>
      <td><%= i.plan_name %></td>
      <td>
        <% if (i.tax_type === 'cgst_sgst') { %>CGST+SGST
        <% } else if (i.tax_type === 'igst') { %>IGST
        <% } else { %>—<% } %>
      </td>
      <td><%= (i.total_cents / 100).toFixed(2) %> <%= i.currency %></td>
      <td><span class="badge <%= i.status === 'paid' ? 'badge-active' : (i.status === 'void' ? 'badge-suspended' : 'badge-revoked') %>"><%= i.status %></span></td>
      <td><%= i.created_at %></td>
      <td><a href="/invoices/<%= i.id %>">View</a></td>
    </tr>
    <% }); %>
    <% if (invoices.length === 0) { %>
    <tr><td colspan="8" class="empty">No invoices yet — one is created automatically whenever a customer completes checkout for a paid plan.</td></tr>
    <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
