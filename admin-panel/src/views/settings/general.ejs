<%- include('../partials/header', { title: 'Settings' }) %>
<div class="page-header">
  <h1>Settings</h1>
</div>
<div class="tabs">
  <a href="/settings" class="tab active">General</a>
  <a href="/settings/payment-gateways" class="tab">Payment Gateways</a>
  <a href="/settings/invoice" class="tab">Invoice</a>
</div>

<% errors.forEach(function(e) { %><p class="alert alert-error"><%= e.msg %></p><% }); %>

<form method="post" action="/settings" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <label>Site Name
    <input type="text" name="site_name" value="<%= settings.site_name %>" required maxlength="120" />
  </label>

  <label>Support Email
    <input type="email" name="support_email" value="<%= settings.support_email %>" maxlength="255" />
  </label>

  <label>Currency
    <select name="currency" required>
      <% currencies.forEach(function(c) { %>
      <option value="<%= c.code %>" <%= settings.currency === c.code ? 'selected' : '' %>><%= c.label %></option>
      <% }); %>
    </select>
    <span class="hint">Default currency for new plans. Existing plans keep whatever currency they were created with.</span>
  </label>

  <button type="submit">Save settings</button>
</form>
<%- include('../partials/footer') %>
