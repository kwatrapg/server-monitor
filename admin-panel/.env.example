# Copy to .env and fill in. Keep .env out of version control.

NODE_ENV=production
PORT=4001

# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/admin.sqlite

# Long random string used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Long random string used to HMAC-sign license verification API responses,
# so callers (e.g. the main monitor app) can verify authenticity.
# Generate the same way as SESSION_SECRET.
LICENSE_HMAC_SECRET=

# Comma-separated list of IPs/CIDRs allowed to hit the admin UI. Leave blank to allow all
# (only do this behind a reverse proxy / VPN that already restricts access).
TRUSTED_ADMIN_IPS=

# Set to 1 if running behind a reverse proxy (nginx/apache) so secure cookies
# and client IPs are handled correctly.
TRUST_PROXY=0
