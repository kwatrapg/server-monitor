# Sentruo environment template — copy to .env, fill in, chmod 600.
# In production keep the real .env OUTSIDE the web root and point to it with
# SENTRUO_ENV_FILE=/etc/sentruo/env  (see docs/DEPLOYMENT.md).

APP_ENV=production
# 64 hex chars. Generate: php -r 'echo bin2hex(random_bytes(32))."\n";'
# Used for HMACs/token hashing AND to encrypt secrets stored in core_config
# (e.g. the SMTP password set via Settings > Email). Losing this key makes
# those stored secrets unrecoverable — back it up alongside the DB.
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sentruo
DB_USER=sentruo
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Comma-separated IPs of trusted reverse proxies (enables X-Forwarded-For).
TRUSTED_PROXIES=

# Only needed if crons/cron.php is triggered over HTTP instead of CLI.
CRON_TOKEN=

# Agent ingest
AGENT_REQUIRE_SIGNATURE=true
AGENT_ALLOW_HTTP=false
AGENT_HMAC_SECRET=

# SMTP is configured entirely from the app (Settings > Email), not here.
# The password is encrypted at rest in core_config using APP_KEY above.

# Set to 1 to allow monitoring probes to reach private/reserved IP ranges.
ALLOW_PRIVATE_PROBE_TARGETS=false

# SaaS license verification — base URL of the admin-panel service (see
# admin-panel/README.md) and the LICENSE_HMAC_SECRET configured there.
# Leave both blank to disable licensing entirely (unlimited, self-hosted
# behaviour). Set both to enforce plan limits from a license key entered at
# Settings > License.
LICENSE_API_URL=
LICENSE_HMAC_SECRET=
